# These are documentation examples. The server reads process environment variables;
# it does not load .env automatically. Never put real keys into version control.
PUZZGEN_LISTEN=127.0.0.1:8080
PUZZGEN_STATIC_DIR=frontend/dist
PUZZGEN_WORKERS=4
PUZZGEN_REQUESTS_PER_MINUTE=120
# Optional comma-separated random ASCII tokens of 32+ characters:
# PUZZGEN_API_KEYS=replace-with-a-random-secret-at-least-32-characters
RUST_LOG=puzzgen=info,tower_http=info

# Enable member accounts using a dedicated PostgreSQL database on this host.
# DATABASE_URL=postgres://puzzgen:replace-me@127.0.0.1:5432/puzzgen
# PUZZGEN_PUBLIC_ORIGIN=https://puzzles.example.com
PUZZGEN_REGISTRATION_OPEN=true
# Optional anonymous Android access; requires PostgreSQL and applied migrations.
# Trust exactly one Firebase project for this environment. Never use the dev
# project on the production server (or the production project on the dev server).
# PUZZGEN_FIREBASE_PROJECT_ID=beacon-and-bough-testing
# For local browser development use http://127.0.0.1:8080 (or :8081 for Trunk).
# Apply migrations explicitly, then create the protected owner interactively:
# cargo run --locked -p puzzgen -- migrate
# cargo run --locked -p puzzgen -- create-admin

